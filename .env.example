PORT=4477
MONGODB_CONNECTION_URI=
MONGODB_DB_NAME=
REDIS_CONNECTION_STRING=
QUEUE_CONNECTIONURL=
AI_MIDDLEWARE_AUTH_KEY=
OPENAI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
MASTER_API_KEY=

# Team-memory POC (src/memory)
# openai (uses OPENAI_API_KEY above) or gemini (uses GEMINI_API_KEY)
MEMORY_LLM_PROVIDER=openai
GEMINI_API_KEY=
# Leave these empty to use the provider defaults
# (openai: gpt-4.1-mini, text-embedding-3-small, temperature 0;
#  gemini: gemini-3.8-flash, gemini-embedding-001, model-default temperature)
MEMORY_LLM_MODEL=
MEMORY_EMBED_MODEL=
# Number, or "default" to leave it unset (reasoning models reject a fixed temperature)
MEMORY_LLM_TEMPERATURE=
# Thinking budget for reasoning models: low | medium | high (empty = model default). "low" ~halves Gemini latency.
MEMORY_LLM_REASONING_EFFORT=
# Jev (typesafe/jev-1.13) via OpenRouter, for the +gate / +router variants
OPENROUTER_API_KEY=
MEMORY_PG_URL=postgres://memory:memory@127.0.0.1:5433
MEMORY_NEO4J_URL=bolt://127.0.0.1:7688
MEMORY_NEO4J_USER=neo4j
MEMORY_NEO4J_PASSWORD=memory-poc
# Optional, for `memory:eval --parallel`: one Neo4j per graph variant (start them with --profile eval-pool).
# Embedding server for temporal-kg +gemma versions (the team's FastEmbed service: POST /embed {texts, model}).
# MEMORY_REMOTE_EMBED_URL=http://profiler-embedding.rtlayer.com
# MEMORY_REMOTE_EMBED_MODEL=google/embeddinggemma-300m
# Working memory (temporal-kg +consolidate): messages per batch, max minutes a message waits, waiting messages shown at recall.
# MEMORY_WM_BATCH_SIZE=12
# MEMORY_WM_MAX_AGE_MIN=10
# MEMORY_WM_READ_SLOTS=5
# MEMORY_NEO4J_POOL=bolt://127.0.0.1:7688,bolt://127.0.0.1:7689,bolt://127.0.0.1:7690,bolt://127.0.0.1:7691,bolt://127.0.0.1:7692,bolt://127.0.0.1:7693
# Team memory MCP server (pm2 app "memory-mcp", src/memory/mcp/server.ts). Deployed for the team:
# MEMORY_MCP_NEO4J_URL=bolt://<neo4j-host>:7687
# MEMORY_MCP_HOST=0.0.0.0
# MEMORY_MCP_PORT=7800
# MEMORY_MCP_PUBLIC_URL=https://memory.example.com
# MEMORY_MCP_VERSIONS=temporal-kg+vecmatch+rank+serial+crowd+gemma+link+consolidate
# MEMORY_MCP_TOKENS=p-ankit:<long-random-token>,p-priya:<long-random-token>
# MEMORY_MCP_UI=false
