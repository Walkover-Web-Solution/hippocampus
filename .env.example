PORT=4477
MONGODB_CONNECTION_URI=
MONGODB_DB_NAME=
REDIS_CONNECTION_STRING=
QUEUE_CONNECTIONURL=
AI_MIDDLEWARE_AUTH_KEY=
OPENAI_API_KEY=
# For a Claude extraction model (the memory default is claude-haiku-5-5).
ANTHROPIC_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
MASTER_API_KEY=

# Memory (src/memory): on when MEMORY_DATABASE_URL points at a Postgres with the pgvector extension (>= 0.5).
MEMORY_DATABASE_URL=
MEMORY_DATABASE_SSL=false
# Signers allowed to mint memory tokens, as JSON {"issuer":"secret"}; more can be added through /memory/admin/signers.
MEMORY_SIGNERS={"viasocket":"change-me"}
# Any dense model the Encoder knows; the dimensions must match it. The default, google/embeddinggemma-300m (768), runs in the
# FastEmbed sidecar (fastembed/, EMBEDDING_SERVER) and needs no API key; text-embedding-3-small (1536) needs OPENAI_API_KEY_EMBEDDING.
MEMORY_EMBEDDING_MODEL=google/embeddinggemma-300m
MEMORY_EMBEDDING_DIMENSIONS=768
# Cosine distance beyond which a memory is not returned; the default follows the model (0.72 for EmbeddingGemma, 0.8 for OpenAI).
# MEMORY_MAX_DISTANCE=0.72
# Where the FastEmbed sidecar listens (fastembed/main.py; default http://127.0.0.1:8000)
# EMBEDDING_SERVER=http://127.0.0.1:8000
# The chat model behind learn, merge, links, lessons and summaries: a Claude model (ANTHROPIC_API_KEY) or an OpenAI model
# (OPENAI_API_KEY). Default claude-haiku-5-5. Score a candidate first: MEMORY_EXTRACTION_MODEL=... npm run memory:eval
MEMORY_EXTRACTION_MODEL=claude-haiku-5-5
# MEMORY_EXTRACTION_EFFORT=low
# A second extraction model, from the other provider, used when the first one fails. Default gpt-4.1-mini behind claude-haiku-5-5,
# so an Anthropic outage falls back to OpenAI; set empty for no fallback. Both providers' keys are needed for this to work.
MEMORY_EXTRACTION_FALLBACK_MODEL=gpt-4.1-mini
# Set to true for one start after changing MEMORY_EMBEDDING_MODEL on a database that already has an index: drops the chunks,
# resizes the vector column and re-indexes every note. Otherwise the mismatch is logged as an error at start and memory writes fail.
# MEMORY_EMBEDDING_REINDEX=false
MEMORY_QUEUE=memory
# The standalone memory server (npm run memory:server) and the integration test database
MEMORY_PORT=4478
MEMORY_TEST_DATABASE_URL=
